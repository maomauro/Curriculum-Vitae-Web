<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BCrypt.Net-Next" Version="4.0.3" />
    <PackageReference Include="MailKit" Version="4.17.0" />
    <!-- 10.0.9 (no 10.0.5): version minima que exige MySql.EntityFrameworkCore 10.0.9 -->
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="MySql.EntityFrameworkCore" Version="10.0.9" />
    <PackageReference Include="QuestPDF" Version="2026.7.3" />
    <!-- Antes llegaba de arrastre via Microsoft.Data.SqlClient (soporte Azure AD).
         Al sacar el paquete de SQL Server para migrar a MariaDB, AuthService.cs
         (que firma el JWT a mano) se quedo sin esta dependencia transitiva. -->
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.15.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PortalCV.Domain\PortalCV.Domain.csproj" />
    <ProjectReference Include="..\PortalCV.Application\PortalCV.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
