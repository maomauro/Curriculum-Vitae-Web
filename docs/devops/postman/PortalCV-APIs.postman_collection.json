    {
      "name": "01 - Auth",
      "item": [
        {
          "name": "POST /api/auth/login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "// El JWT ya no viaja en el body de login (ver AuthController.SetAuthCookie):",
                  "// viaja como cookie HttpOnly 'portalcv_auth'. Postman la guarda solo en su",
                  "// cookie jar (Cookies > <dominio de baseUrl>) y la reenvia automaticamente",
                  "// en las siguientes requests a ese mismo dominio; no hay nada que copiar a mano.",
                  "pm.test('status 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('body no incluye el token (solo va en la cookie)', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('\"token\"');",
                  "});",
                  "",
                  "var data = {};",
                  "try { data = pm.response.json(); } catch (e) {}",
                  "",
                  "if (data.expiracion) {",
                  "  pm.environment.set('jwtExpiracion', data.expiracion);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{authEmail}}\",\n  \"password\": \"{{authPassword}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            }
          },
          "response": []
        },
        {
          "name": "GET /api/auth/me",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/me",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "me"
              ]
            }
          },
          "response": []
        }
      ]
