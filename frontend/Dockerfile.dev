# Imagen SOLO para desarrollo local con hot-reload (docker-compose.yml).
# El frontend no tiene imagen de produccion: se despliega a Azure Static Web Apps
# como build estatico (npm run build), no como contenedor.
FROM node:22-alpine

WORKDIR /app

# package*.json aparte del resto del codigo para cachear "npm ci" entre builds.
COPY package*.json ./
RUN npm ci

# El resto del codigo llega por bind mount en tiempo de ejecucion
# (ver "volumes" del servicio frontend en docker-compose.yml).

EXPOSE 4200

# proxyConfig ya esta configurado en angular.json (proxy.conf.js), que lee
# PORTALCV_API_PROXY_TARGET (seteado en docker-compose.yml) para apuntar al backend.
ENTRYPOINT ["npx", "ng", "serve", "--host", "0.0.0.0"]
