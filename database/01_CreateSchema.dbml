Table Rol {
  RolId int [pk, increment, not null]
  NombreRol varchar(50) [not null]
  Descripcion varchar(255)
}

Table Usuario {
  UsuarioId int [pk, increment, not null]
  Email varchar(100) [not null]
  PasswordHash varchar(255) [not null]
  Estado varchar(20) [not null, default: 'Activo']
  FechaRegistro datetime [not null, default: `now()`]
}

Table UsuarioRol {
  UsuarioRolId int [pk, increment, not null]
  UsuarioId int [not null]
  RolId int [not null]
  indexes {
    (UsuarioId, RolId) [unique]
  }
}

Table Curriculum {
  CurriculumId int [pk, increment, not null]
  UsuarioId int [not null]
  UrlPublica varchar(255) [not null]
  Estado varchar(20) [not null, default: 'Borrador']
  ContadorVisitas int [not null, default: 0]
  ContadorContactos int [not null, default: 0]
  FechaCreacion datetime [not null, default: `now()`]
  FechaActualizacion datetime [not null, default: `now()`]
  indexes {
    (UrlPublica) [name: "IX_Curriculum_UrlPublica"]
    (Estado) [name: "IX_Curriculum_Estado"]
  }
}

Table Personales {
  PersonalesId int [pk, increment, not null]
  CurriculumId int [not null]
  TipoIdentificacion varchar(50)
  NumeroDocumento varchar(50)
  FechaExpedicion date
  LugarExpedicion varchar(100)
  LibretaMilitarNumero varchar(50)
  LibretaMilitarClase varchar(20)
  PasaporteNumero varchar(50)
  PasaporteVigencia date
  VisaNumero varchar(50)
  VisaVigencia date
  VisaClase varchar(50)
  PrimerNombre varchar(50) [not null]
  SegundoNombre varchar(50)
  PrimerApellido varchar(50) [not null]
  SegundoApellido varchar(50)
  FechaNacimiento date
  LugarNacimiento varchar(100)
  Genero varchar(20)
  Nacionalidad varchar(50)
  TipoSangre varchar(10)
  EPS varchar(100)
  Pencion varchar(100)
  Cesantias varchar(100)
  Email varchar(100)
  Celular varchar(20)
  TelefonoFijo varchar(20)
  Pais varchar(50)
  Departamento varchar(50)
  Ciudad varchar(50)
  Barrio varchar(100)
  CodigoPostal varchar(20)
  Direccion varchar(255)
  TipoResidencia varchar(50)
  FotoUrl varchar(500) [note: 'Legacy: URL pegada por el usuario. Ignorada si FotoBytes tiene valor.']
  FotoBytes blob
  FotoContentType varchar(100)
}

Table Referencia {
  ReferenciaId int [pk, increment, not null]
  CurriculumId int [not null]
  TipoReferencia varchar(20) [not null]
  ExperienciaId int
  Nombre varchar(100) [not null]
  Apellido varchar(100)
  Email varchar(100)
  Telefono varchar(20)
  Parentesco varchar(50)
  Cargo varchar(100)
  Empresa varchar(150)
  Relacion varchar(100)
  Observaciones varchar(500)
  AdjuntoSoporte varchar(500)
  FechaRegistro datetime [not null, default: `now()`]
  indexes {
    (CurriculumId) [name: "IX_Referencia_CurriculumId"]
    (TipoReferencia) [name: "IX_Referencia_TipoReferencia"]
  }
}

Table FamiliarContacto {
  FamiliarId int [pk, increment, not null]
  CurriculumId int [not null]
  Parentesco varchar(50)
  Nombres varchar(100)
  Apellidos varchar(100)
  Email varchar(100)
  Telefono varchar(20)
  EsContactoPrincipal boolean [not null, default: 0]
}

Table RedSocial {
  RedSocialId int [pk, increment, not null]
  CurriculumId int [not null]
  NombreRed varchar(50) [not null]
  LinkPublico varchar(500)
  UsuarioContacto varchar(100)
  MostrarEnCv boolean [not null, default: 1]
}

Table Perfil {
  PerfilId int [pk, increment, not null]
  CurriculumId int [not null]
  NombrePerfil varchar(100)
  DescripcionPerfil text
  ExperienciaPerfilAnios decimal(5,2)
  AspiracionSalarialPesos decimal(18,2)
  AspiracionSalarialDolares decimal(18,2)
  EsActivo boolean [not null, default: 1]
}

Table Oferta {
  OfertaId int [pk, increment, not null]
  CurriculumId int [not null]
  Cargo varchar(150) [not null]
  Empresa varchar(150) [not null]
  Descripcion text
  CorreoReclutador varchar(150)
  NombreReclutador varchar(150)
  TextoOriginal text [not null]
  OrigenEntrada varchar(20) [not null, note: 'texto | imagen']
  Estado varchar(20) [not null, note: 'Analizada | PerfilAsignado | CvGenerado']
  PerfilId int
  FechaAnalisis datetime [not null]
}

Table Experiencia {
  ExperienciaId int [pk, increment, not null]
  CurriculumId int [not null]
  Empresa varchar(150)
  Cargo varchar(100)
  Sector varchar(100)
  FechaInicio date
  FechaFin date
  TipoContrato varchar(50)
  MotivoRetiro varchar(255)
  Funciones text
  EsActual boolean [not null, default: 0]
  MostrarEnCv boolean [not null, default: 1]
  AdjuntoSoporte varchar(500) [note: 'Legacy: URL pegada por el usuario. Ignorada si AdjuntoSoporteBytes tiene valor.']
  AdjuntoSoporteBytes blob
  AdjuntoSoporteContentType varchar(100)
  FechaRegistro datetime [not null, default: `now()`]
  indexes {
    (CurriculumId) [name: "IX_Experiencia_CurriculumId"]
  }
}

Table Formacion {
  FormacionId int [pk, increment, not null]
  CurriculumId int [not null]
  Titulo varchar(200)
  Institucion varchar(200)
  Area varchar(100)
  FechaInicio date
  FechaFin date
  TipoFormacion varchar(50)
  Descripcion text
  AdjuntoSoporte varchar(500) [note: 'Legacy: URL pegada por el usuario. Ignorada si AdjuntoSoporteBytes tiene valor.']
  AdjuntoSoporteBytes blob
  AdjuntoSoporteContentType varchar(100)
  FechaVigencia date
  DuracionHoras int
  MostrarEnCv boolean [not null, default: 1]
}

Table Habilidad {
  HabilidadId int [pk, increment, not null]
  CurriculumId int [not null]
  Nombre varchar(100) [not null]
  Tipo varchar(30)
  Nivel varchar(30)
  Descripcion varchar(500)
  NivelLectura varchar(5)
  NivelEscritura varchar(5)
  NivelEscucha varchar(5)
  NivelHabla varchar(5)
  MostrarEnCv boolean [not null, default: 1]
  indexes {
    (CurriculumId) [name: "IX_Habilidad_CurriculumId"]
    (Nombre) [name: "IX_Habilidad_Nombre"]
  }
}

Table Proyecto {
  ProyectoId int [pk, increment, not null]
  CurriculumId int [not null]
  NombreProyecto varchar(200)
  Rol varchar(100)
  EquipoTamano int
  DuracionMeses int
  StackTecnologico varchar(500)
  Aporte text
  Logro text
  Desafio text
  MostrarEnCv boolean [not null, default: 1]
}

Table VisitanteContacto {
  VisitanteContactoId int [pk, increment, not null]
  CurriculumId int [not null]
  Nombre varchar(100)
  Correo varchar(100) [not null]
  Empresa varchar(150)
  MotivoContacto varchar(255)
  Asunto varchar(255)
  ComoMeEncontraste varchar(255)
  Mensaje text
  FechaContacto datetime [not null, default: `now()`]
  EsLeido bit [not null, default: 0]
  indexes {
    (CurriculumId) [name: "IX_VisitanteContacto_CurriculumId"]
    (FechaContacto) [name: "IX_VisitanteContacto_FechaContacto"]
  }
}

Table AlertaVisita {
  AlertaVisitaId int [pk, increment, not null]
  CurriculumId int [not null]
  FechaVisita datetime [not null, default: `now()`]
  Origen varchar(255)
  TipoVisita varchar(20)
  EsLeida boolean [not null, default: 0]
  Titulo varchar(255)
  Descripcion text
  Ciudad varchar(100)
  Pais varchar(100)
  indexes {
    (CurriculumId) [name: "IX_AlertaVisita_CurriculumId"]
    (FechaVisita) [name: "IX_AlertaVisita_FechaVisita"]
  }
}

Table VisibilidadSeccion {
  VisibilidadSeccionId int [pk, increment, not null]
  CurriculumId int [not null]
  NombreSeccion varchar(100) [not null]
  EsVisible boolean [not null, default: 1]
}

Table EstadisticasPublicas {
  EstadisticasId int [pk, increment, not null]
  CurriculumId int [not null]
  TotalVisitas int [not null, default: 0]
  TotalContactos int [not null, default: 0]
  UltimaVisita datetime
  FechaActualizacion datetime [not null, default: `now()`]
}

Table AuditoriaAdmin {
  AuditoriaAdminId int [pk, increment, not null]
  FechaUtc datetime [not null, default: `now()`]
  ActorUsuarioId int [note: 'NULL si el actor fue eliminado']
  Accion varchar(80) [not null]
  EntidadTipo varchar(40) [not null]
  EntidadId int
  DetalleJson text
  indexes {
    (FechaUtc) [name: "IX_AuditoriaAdmin_FechaUtc"]
  }
}

Table AuditoriaAuth {
  AuditoriaAuthId int [pk, increment, not null]
  FechaUtc datetime [not null, default: `now()`]
  ActorUsuarioId int [note: 'NULL en login fallido o si el actor fue eliminado']
  Accion varchar(80) [not null]
  Email varchar(256) [not null]
  DetalleJson text
  IpOrigen varchar(45) [note: 'IPv4 o IPv6, para detectar fuerza bruta']
  indexes {
    (FechaUtc) [name: "IX_AuditoriaAuth_FechaUtc"]
  }
}

Table AuditoriaCv {
  AuditoriaCvId int [pk, increment, not null]
  FechaUtc datetime [not null, default: `now()`]
  ActorUsuarioId int [note: 'NULL si el actor fue eliminado']
  CurriculumId int [not null]
  Accion varchar(80) [not null]
  EntidadTipo varchar(40) [not null]
  EntidadId int
  DetalleJson text
}

Table PromptIa {
  PromptIaId int [pk, increment, not null]
  CurriculumId int [not null, note: 'Dueño del prompt: cada CV administra los suyos']
  Codigo varchar(50) [not null, note: 'Identifica el prompt para su dueño, p. ej. EXTRACTOR_OFERTA. Repetido entre versiones y entre CV distintos']
  Nombre varchar(150) [not null]
  Descripcion varchar(500)
  RolContexto text [not null, note: 'Quién es la IA, para qué sistema trabaja']
  Tarea text [not null, note: 'Qué debe hacer, incluye dónde va el marcador de entrada (ej. {{OFERTA_TEXTO}})']
  Reglas text [note: 'Restricciones y casos especiales (opcional)']
  FormatoSalida text [not null, note: 'Schema/ejemplo exacto de la respuesta esperada']
  Ejemplos text [note: 'Ejemplos few-shot (opcional)']
  Contenido text [not null, note: 'Ensamblado por la app desde las 5 columnas de arriba; nunca se edita a mano']
  Version int [not null, default: 1]
  EsActivo boolean [not null, default: true, note: 'Solo una fila activa por (CurriculumId, Codigo)']
  FechaCreacion datetime [not null, default: `now()`]
  ActualizadoPorUsuarioId int
  indexes {
    (CurriculumId, Codigo) [unique, name: "UQ_PromptIa_Curriculum_Codigo_Activo", note: 'Filtrado por EsActivo=1']
    (CurriculumId, Codigo, Version) [unique, name: "UQ_PromptIa_Curriculum_Codigo_Version"]
    (CurriculumId, Codigo) [name: "IX_PromptIa_Curriculum_Codigo"]
  }
}

Table ProveedorIaConfig {
  ProveedorIaConfigId int [pk, increment, not null]
  CurriculumId int [not null, note: 'Un CV puede tener varias conexiones guardadas']
  Proveedor varchar(20) [not null, note: 'claude | openai | gemini | ollama | otro']
  Nombre varchar(100) [note: 'Alias opcional para distinguir varias conexiones del mismo proveedor']
  Modelo varchar(100)
  Endpoint varchar(500) [note: 'URL del servidor; obligatorio para proveedores self-hosted (ollama)']
  ApiKeyCifrada text [note: 'AES-256-GCM (AesGcmApiKeyCipher); opcional (ollama local no siempre la requiere); nunca se devuelve al front-end']
  EsActivo boolean [not null, default: false, note: 'Solo una conexion activa por CV a la vez — la que usa el flujo de Ofertas']
  FechaCreacion datetime [not null, default: `now()`]
  FechaActualizacion datetime [not null, default: `now()`]
  indexes {
    CurriculumId [name: "IX_ProveedorIaConfig_CurriculumId"]
    CurriculumId [unique, name: "UQ_ProveedorIaConfig_Curriculum_Activo", note: 'Filtrado por EsActivo=1']
  }
}

Ref: UsuarioRol.UsuarioId > Usuario.UsuarioId
Ref: UsuarioRol.RolId > Rol.RolId
Ref: Curriculum.UsuarioId > Usuario.UsuarioId
Ref: Personales.CurriculumId > Curriculum.CurriculumId
Ref: Referencia.CurriculumId > Curriculum.CurriculumId
Ref: Referencia.ExperienciaId > Experiencia.ExperienciaId
Ref: FamiliarContacto.CurriculumId > Curriculum.CurriculumId
Ref: RedSocial.CurriculumId > Curriculum.CurriculumId
Ref: Perfil.CurriculumId > Curriculum.CurriculumId
Ref: Oferta.CurriculumId > Curriculum.CurriculumId
Ref: Oferta.PerfilId > Perfil.PerfilId
Ref: Experiencia.CurriculumId > Curriculum.CurriculumId
Ref: Formacion.CurriculumId > Curriculum.CurriculumId
Ref: Habilidad.CurriculumId > Curriculum.CurriculumId
Ref: Proyecto.CurriculumId > Curriculum.CurriculumId
Ref: VisitanteContacto.CurriculumId > Curriculum.CurriculumId
Ref: AlertaVisita.CurriculumId > Curriculum.CurriculumId
Ref: VisibilidadSeccion.CurriculumId > Curriculum.CurriculumId
Ref: EstadisticasPublicas.CurriculumId > Curriculum.CurriculumId
Ref: AuditoriaAdmin.ActorUsuarioId > Usuario.UsuarioId
Ref: AuditoriaAuth.ActorUsuarioId > Usuario.UsuarioId
Ref: AuditoriaCv.ActorUsuarioId > Usuario.UsuarioId
Ref: AuditoriaCv.CurriculumId > Curriculum.CurriculumId
Ref: PromptIa.CurriculumId > Curriculum.CurriculumId
Ref: PromptIa.ActualizadoPorUsuarioId > Usuario.UsuarioId
Ref: ProveedorIaConfig.CurriculumId > Curriculum.CurriculumId
