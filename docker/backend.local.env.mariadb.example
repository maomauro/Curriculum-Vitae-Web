# Plantilla de variables de entorno del backend para Docker local, apuntando a MariaDB.
#
#   PowerShell: Copy-Item docker/backend.local.env.mariadb.example docker/backend.local.env
#
# Luego:
#   docker run -d --name portalcv-mariadb-local -e MARIADB_ROOT_PASSWORD=REEMPLAZAR -p 3306:3306 mariadb:11
#   mariadb -h 127.0.0.1 -uroot -pREEMPLAZAR < database/01_CreateSchema.sql
#   docker build -f backend/Dockerfile -t portalcv-backend:local ./backend
#   docker run --rm -p 5005:8080 --add-host=host.docker.internal:host-gateway --env-file docker/backend.local.env --name portalcv-api-local portalcv-backend:local

ASPNETCORE_ENVIRONMENT=Development

# Expone la API en el puerto interno esperado por el Dockerfile (8080).
ASPNETCORE_URLS=http://+:8080

# Evita que HttpClient intente la ruta IPv6 primero (Happy Eyeballs) contra las
# APIs de IA en la nube y se cuelgue hasta agotar el timeout.
DOTNET_SYSTEM_NET_DISABLEIPV6=1

# Si MariaDB corre en OTRO contenedor Docker (docker run aparte, no docker-compose),
# usa el nombre del contenedor como host si estan en la misma red de Docker, o
# host.docker.internal si MariaDB corre nativo en tu Windows.
ConnectionStrings__DefaultConnection=server=host.docker.internal;port=3306;database=portalcv;user=REEMPLAZAR_USUARIO_MARIADB;password=REEMPLAZAR_PASSWORD_MARIADB;

Jwt__Issuer=PortalCV.Api
Jwt__Audience=PortalCV.Client
Jwt__Key=REEMPLAZAR_CLAVE_JWT_MINIMO_32_CARACTERES

# Clave AES-256 (32 bytes) en base64 -- cifra la clave de API de cada conexion en
# ProveedorIa (ver AesGcmApiKeyCipher). Generar con: openssl rand -base64 32
Encryption__Key=REEMPLAZAR_CLAVE_AES256_32_BYTES_BASE64
