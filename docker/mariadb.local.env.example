# Credenciales para el contenedor de MariaDB del docker-compose.yml local.
# Copia este archivo a `docker/mariadb.local.env` (NO versionado) y completa valores reales.
#
#   PowerShell: Copy-Item docker/mariadb.local.env.example docker/mariadb.local.env
#
# El backend (ver backend/entrypoint.dev.sh) usa MARIADB_DATABASE/USER/PASSWORD para
# armar su propia connection string, asi que estos valores son la unica fuente de verdad
# para el nombre de la base, usuario y password locales.

MARIADB_ROOT_PASSWORD=REEMPLAZAR_PASSWORD_ROOT
MARIADB_DATABASE=portalcv
MARIADB_USER=REEMPLAZAR_USUARIO_MARIADB
MARIADB_PASSWORD=REEMPLAZAR_PASSWORD_MARIADB
