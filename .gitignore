# ── Entorno ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# Variables reales para docker run (ver docker/backend.local.env.mariadb.example)
docker/backend.local.env
# Variables reales para el contenedor MariaDB del docker-compose.yml local
docker/mariadb.local.env

# ── .NET / Backend ───────────────────────────────────────────────────────────
backend/**/bin/
backend/**/obj/
backend/**/*.user
**/.vs/
# Herramientas de consola de un solo uso (scripts/mariadb/tools/...)
scripts/**/bin/
scripts/**/obj/
# Salidas locales de pruebas de compilación (no versionar)
backend/_build_out*/

# Resultados de `dotnet test` (TRX, cobertura local, etc.)
backend/TestResults/
backend/**/TestResults/

# Configuración local con credenciales — nunca commitear
**/appsettings.Development.json
**/appsettings.Local.json

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/*.log

# ── Datos sensibles ──────────────────────────────────────────────────────────
# Dumps SQL de ejemplo con datos reales (documento, direccion, hash de password).
# Nunca versionar: si necesitas un script de ejemplo para el equipo, usar datos ficticios.
scripts/ejemplo/

# ── Sistema operativo ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

