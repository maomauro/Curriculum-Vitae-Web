# ── Entorno ──────────────────────────────────────────────────────────────────
.env
.env.local
.env.*.local

# Variables reales para docker run (ver docker/backend.local.env.mariadb.example)
docker/backend.local.env
# Variables reales para el contenedor MariaDB del docker-compose.yml local
docker/mariadb.local.env
# Variables reales de produccion (ver docker-compose.prod.yml, Plan-Trabajo-Produccion.md Fase 5)
docker/backend.prod.env
docker/mariadb.prod.env

# ── .NET / Backend ───────────────────────────────────────────────────────────
backend/**/bin/
backend/**/obj/
backend/**/*.user
**/.vs/
# Salidas locales de pruebas de compilación (no versionar)
backend/_build_out*/

# Resultados de `dotnet test` (TRX, cobertura local, etc.)
backend/TestResults/
backend/**/TestResults/

# Configuración local con credenciales — nunca commitear
**/appsettings.Development.json
**/appsettings.Local.json

# ── Node / Frontend ──────────────────────────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/.angular/
frontend/*.log

# ── Datos sensibles ──────────────────────────────────────────────────────────
# Dump local de la base de datos (datos reales, generado con mariadb-dump) — nunca
# versionar. Vive junto al resto de lo relacionado a base de datos (database/), no en
# una carpeta scripts/ aparte.
database/portalcv_local_dump.sql

# ── Sistema operativo ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── IDE ──────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

